{
  "name": "@lector-cedula/servidor",
  "version": "0.1.0",
  "description": "SDK de backend para Node del lector de cédula: crearLectorServidor (protocolo NDJSON con el motor en proceso), sesiones, resultados y verificación de webhooks (cambios sdk-integracion y motor-backend-embebido).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "edge-light": "./edge.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "default": "./dist/nest.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    }
  },
  "files": ["dist", "edge.js", "LICENSE", "THIRD_PARTY_NOTICES"],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "ajv": "6.15.0",
    "express": "^4.22.3",
    "fastify": "^5.12.5",
    "@lector-cedula/motor": "0.1.0"
  },
  "dependencies": {
    "@lector-cedula/protocolo": "0.1.0"
  },
  "peerDependencies": {
    "@lector-cedula/motor": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@lector-cedula/motor": {
      "optional": true
    }
  }
}
