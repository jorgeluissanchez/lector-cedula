{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lector-cedula.example/protocolo-ndjson.schema.json",
  "title": "Evento del protocolo NDJSON de @lector-cedula/servidor (MOT-20, MOT-22, MOT-25)",
  "definitions": {
    "motivo": {
      "enum": [
        "no-coincide",
        "fraude",
        "ilegible",
        "menor-de-edad",
        "documento-no-admitido",
        "demasiado-grande",
        "tiempo-agotado",
        "ocupado",
        "error-interno"
      ]
    },
    "fechaIso": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      ]
    },
    "campos": {
      "description": "MOT-27 y SDK-65: tipos de las claves de CamposDocumento cuando están presentes; se admiten claves ausentes y adicionales.",
      "type": "object",
      "properties": {
        "numeroDocumento": {
          "type": [
            "string",
            "null"
          ]
        },
        "apellidos": {
          "type": "string"
        },
        "nombres": {
          "type": "string"
        },
        "fechaNacimiento": {
          "$ref": "#/definitions/fechaIso"
        },
        "fechaVencimiento": {
          "$ref": "#/definitions/fechaIso"
        },
        "sexo": {
          "enum": [
            "M",
            "F",
            "X",
            null
          ]
        },
        "nacionalidad": {
          "type": [
            "string",
            "null"
          ]
        },
        "paisEmisor": {
          "type": "string"
        },
        "nuip": {
          "type": [
            "string",
            "null"
          ]
        },
        "rh": {
          "enum": [
            "A+",
            "A-",
            "B+",
            "B-",
            "AB+",
            "AB-",
            "O+",
            "O-"
          ]
        },
        "lugarNacimiento": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "codigo": {
                  "type": "string"
                },
                "departamento": {
                  "type": "string"
                },
                "municipio": {
                  "type": "string"
                }
              },
              "required": [
                "codigo",
                "departamento",
                "municipio"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "etapa": {
          "enum": [
            "recibido",
            "leyendo",
            "fraude",
            "comparando"
          ]
        },
        "progreso": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "etapa"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "etapa": {
          "const": "resultado"
        },
        "ok": {
          "type": "boolean"
        },
        "documento": {
          "type": "object",
          "properties": {
            "campos": {
              "$ref": "#/definitions/campos"
            }
          },
          "required": [
            "campos"
          ]
        },
        "riesgo": {},
        "rechazo": {
          "type": "object",
          "properties": {
            "motivo": {
              "$ref": "#/definitions/motivo"
            },
            "diferencias": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "motivo"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "etapa",
        "ok"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "documento"
        ],
        "not": {
          "required": [
            "rechazo"
          ]
        }
      },
      "else": {
        "required": [
          "rechazo"
        ],
        "not": {
          "required": [
            "documento"
          ]
        }
      }
    }
  ]
}
