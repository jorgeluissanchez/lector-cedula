{
  "name": "lector-cedula",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "description": "Lector autoalojado de cédula colombiana (PDF417, MRZ, OCR) con antifraude",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "eval": "node evals/runners/eval-campo.mjs",
    "eval:quick": "node evals/runners/eval-campo.mjs --quick",
    "check:licencias": "node tools/licencia-check.mjs",
    "check:privacidad": "node tools/privacidad-check.mjs",
    "divipol:generar": "node tools/divipol/generar-divipol.mjs",
    "divipol:verificar": "node tools/divipol/generar-divipol.mjs --verificar",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:licencias && npm run check:privacidad && npm run eval:quick",
    "test:mutacion": "stryker run",
    "check:completo": "npm run check && npm run test:mutacion",
    "test:e2e": "playwright test",
    "demo": "tsc -b && node tools/demo.mjs",
    "leer-foto": "node tools/leer-foto.mjs",
    "modelos:mrz": "node tools/modelos/descargar-mrz.mjs",
    "eval:mrz-imagen": "tsc -b && node evals/runners/mrz-imagen.mjs",
    "build": "tsc -b",
    "e2e:videos": "node e2e/videos/generar.mjs",
    "test:visual": "node tools/visual.mjs",
    "test:lighthouse": "npm run build -w @lector-cedula/pwa && node tools/lighthouse.mjs",
    "test:webkit": "node tools/visual.mjs --webkit",
    "fraude:sinteticos": "tsc -b && node tools/fraude/generar-sinteticos.mjs",
    "eval:fraude": "tsc -b && node evals/runners/fraude/eval-fraude.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.19.1",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "mrz": "5.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
