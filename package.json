{
  "name": "lector-cedula",
  "private": true,
  "version": "0.0.0",
  "description": "Lector autoalojado de cédula colombiana (PDF417, MRZ, OCR) con antifraude",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "eval": "node evals/runners/eval-campo.mjs",
    "eval:quick": "node evals/runners/eval-campo.mjs --quick",
    "check:licencias": "node tools/licencia-check.mjs",
    "check:privacidad": "node tools/privacidad-check.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:licencias && npm run check:privacidad && npm run eval:quick"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
