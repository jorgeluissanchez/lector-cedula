# Variables del servicio en Dokploy (pestaña Environment). Plantilla SIN valores: nunca pongas aquí secretos reales.
# Guía: docs/despliegue/README.md (sección "Variables").
LECTOR_LIVE=node
CLAVES_API_JSON=<lista JSON por clave: sha256, secreto_webhook y, por aplicativo, origenes (https exactos) y retornos (URL exactas o deeplinks); ver la guía>
SECRETO_SUBIDA=<cadena aleatoria de 32 bytes o más, por ejemplo openssl rand -hex 32>
URL_PUBLICA=<https://api.tu-dominio>
ORIGENES_CORS=<https://tu-app.vercel.app,https://tu-dominio (solo para claves sin origenes propios; nunca *)>
LIMITE_PETICIONES_POR_MINUTO=<60>
RETENCION_RESULTADOS_S=<86400>
